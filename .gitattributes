# 统一换行符：文本文件入库用 LF，Windows 专用脚本保留 CRLF
* text=auto eol=lf

*.java   text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.sql    text eol=lf
*.md     text eol=lf
*.html   text eol=lf
*.py     text eol=lf

*.bat    text eol=crlf
*.cmd    text eol=crlf

# 二进制文件不做换行转换
*.pdf    binary
*.png    binary
*.jpg    binary
*.jar    binary
